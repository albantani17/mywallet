        "valid_due_day": {
          "name": "valid_due_day",
          "value": "\"debt_schedules\".\"due_day\" IS NULL OR (\"debt_schedules\".\"due_day\" BETWEEN 1 AND 31)"
        },
        "positive_rounding_unit": {

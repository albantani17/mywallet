          "value": "\"debt_schedules\".\"schedule_type\" != 'recurring'\n        OR (\"debt_schedules\".\"anchor_date\" IS NOT NULL AND \"debt_schedules\".\"interval_unit\" IS NOT NULL\n            AND \"debt_schedules\".\"interval_count\" >= 1 AND \"debt_schedules\".\"period_count\" >= 1)"
        },
        "single_shape": {
          "name": "single_shape",
          "value": "\"debt_schedules\".\"schedule_type\" != 'single' OR \"debt_schedules\".\"anchor_date\" IS NOT NULL"
